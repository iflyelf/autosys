#=================================================
#  autosys docker-compose 环境变量样例
#  用法: cp .env.example .env, 按需修改后启动
#    MySQL:      docker compose -f docker-compose-mysql.yml up -d
#    PostgreSQL: docker compose -f docker-compose-postgres.yml up -d
#    SQLite:     docker compose up -d
#  注意: .env 含密码, 不要提交到仓库(已在 .gitignore 中忽略)
#=================================================

# ---------- autosys ----------
# 镜像地址(国内建议改用华为云 SWR)
AUTOSYS_IMAGE=iflyelf/autosys:latest
# AUTOSYS_IMAGE=swr.cn-east-3.myhuaweicloud.com/iflyelf/autosys:latest
# 宿主机映射端口
AUTOSYS_PORT=3000
# 首次启动创建的管理员
SEMAPHORE_ADMIN=admin
SEMAPHORE_ADMIN_PASSWORD=ysyh!9Sky
SEMAPHORE_ADMIN_NAME=管理员
SEMAPHORE_ADMIN_EMAIL=admin@localhost
# 密钥存储加密 key: 生成一次后固定填写, 更换会导致已保存的密钥无法解密
# 生成: head -c32 /dev/urandom | base64
SEMAPHORE_ACCESS_KEY_ENCRYPTION=

# ---------- 通用 ----------
TZ=Asia/Shanghai
LANG=zh_CN.UTF-8

# ---------- MySQL (docker-compose-mysql.yml) ----------
MYSQL_DATABASE=autosys
MYSQL_USER=autosys
MYSQL_PASSWORD=ysyh!9Sky
MYSQL_ROOT_PASSWORD=ysyh!9Sky
# root 允许来源
MYSQL_ROOT_HOST=%
# 自动调优口径(留空 = 按容器 CPU/内存自动计算)
# MYSQL_MEMORY_LIMIT=4Gi
# MYSQL_CPU_LIMIT=2
# MYSQL_MAX_CONNECTIONS=300

# ---------- PostgreSQL (docker-compose-postgres.yml) ----------
POSTGRES_DB=autosys
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ysyh!9Sky
# 自动调优口径(留空 = 按容器 CPU/内存自动计算)
# PG_MEMORY_LIMIT=4Gi
# PG_CPU_LIMIT=2
# PG_MAX_CONNECTIONS=200
